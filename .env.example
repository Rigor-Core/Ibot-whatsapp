# Servidor
PORT=4310
NODE_ENV=production
PUBLIC_BASE_URL=http://localhost:4310

# MongoDB v2. Recomendado usar una DB nueva para no tocar la vieja.
# Con replica set (por ejemplo Atlas) los cambios del panel llegan al bot al instante;
# sin replica set el bot los lee por polling cada 5 segundos.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=Ibotv2

# Seguridad del panel con login/registro y cookie HTTP-only.
PANEL_AUTH_ENABLED=true
PANEL_SECRET=cambia_este_secreto_largo_y_unico
PANEL_SESSION_DAYS=7
# En HTTPS real puedes activar cookie Secure.
COOKIE_SECURE=false
# Valor inicial del registro público. El administrador puede cambiarlo desde su panel
# (Configuración), y ese valor tiene prioridad sobre este.
PANEL_ALLOW_PUBLIC_REGISTRATION=false

# El primer registro en register.html crea al administrador. También: pnpm create:admin

# Dipisik (modo IA). La clave es secreta: solo en el .env del servidor.
DIPISIK_API_KEY=
DIPISIK_BASE_URL=https://dipisik.rigorcore.com/v1

# Almacenamiento local de la sesión, logs y chats de cada usuario.
STORAGE_DIR=storage/accounts

# Notificaciones push (VAPID). Si se dejan vacías se generan una vez y se guardan cifradas en MongoDB.
# Para generarlas: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto para los servicios push (mailto: o URL https). Por defecto usa PUBLIC_BASE_URL si es https.
VAPID_SUBJECT=
